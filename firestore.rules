rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: {userId}
    // Fields:
    //   - uid: string (required) - Firebase Auth UID
    //   - email: string (required) - User email
    //   - displayName: string (optional) - User display name
    //   - photoURL: string (optional) - Profile pic
    //   - preferredMode: string (optional) - UI mode
    //   - createdAt: timestamp (optional) - Creation date
    //
    // Collection: companions
    // Document ID: {companionId}
    // Fields:
    //   - id: string (required) - Internal ID
    //   - name: string (required) - Full name
    //   - age: number (required) - Age
    //   - school: string (required) - Education
    //   - rating: number (required) - User rating
    //   - bio: string (required) - Short bio
    //   - skills: list (required) - Skills array
    //   - createdAt: timestamp (optional) - Seed/Creation date
    //
    // ===============================================================

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      // Primary admin is the user provided in the context
      return isAuthenticated() && 
             (request.auth.token.email == "dauphu122005@gmail.com");
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // Domain Validators
    function isValidUser(data) {
      return data.uid is string && 
             data.email is string &&
             data.email.size() < 100;
    }

    function isValidCompanion(data) {
      return data.name is string && data.name.size() < 100 &&
             data.school is string && data.school.size() < 100;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidUser(request.resource.data) && 
                      (request.resource.data.uid == resource.data.uid);
    }

    match /companions/{companionId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() && isValidCompanion(request.resource.data);
    }
  }
}
